{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gwapupward-hub/oar/blob/main/schema/well-known-0.1.schema.json",
  "title": "Open App Registry domain and repository proof v0.1",
  "description": "Served at https://<host>/.well-known/oar.json (domain proof) or committed as oar.json at a repository root (repository proof).",
  "type": "object",
  "required": ["oar", "apps"],
  "additionalProperties": false,
  "properties": {
    "oar": { "const": "0.1" },
    "apps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["app_id", "cluster"],
        "additionalProperties": false,
        "properties": {
          "app_id": { "type": "string", "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$" },
          "cluster": { "enum": ["solana:mainnet", "solana:devnet", "solana:testnet"] }
        }
      }
    }
  }
}
