diff --git a/community/oar-identity-starter/scripts/import-anchor-programs.mjs b/community/oar-identity-starter/scripts/import-anchor-programs.mjs
new file mode 100644
index 0000000..9ffa5cf
--- /dev/null
+++ b/community/oar-identity-starter/scripts/import-anchor-programs.mjs
@@ -0,0 +1,63 @@
+#!/usr/bin/env node
+// Import public Anchor Devnet program IDs into OAR config with explicit confirmation.
+// Does not run Anchor, sign transactions, or treat a declared address as deployed or verified.
+import { existsSync, readFileSync, writeFileSync } from 'node:fs'
+import { join, resolve } from 'node:path'
+import { parseAnchorDevnetPrograms } from './lib/anchor-programs.mjs'
+
+/** `pnpm run x -- --flag` forwards the `--` separator itself; npm and yarn strip it. */
+const cliArgs = () => (process.argv[2] === '--' ? process.argv.slice(3) : process.argv.slice(2))
+
+function fail(msg) {
+  throw new Error(msg)
+}
+function parse(args) {
+  const options = { workspace: '.', yes: false, replace: false }
+  for (let i = 0; i < args.length; i++) {
+    const a = args[i]
+    if (a === '--workspace') {
+      if (options.workspace !== '.' || !args[i + 1] || args[i + 1].startsWith('--'))
+        fail('Invalid --workspace argument.')
+      options.workspace = args[++i]
+    } else if (a === '--yes') {
+      if (options.yes) fail('Repeated --yes.')
+      options.yes = true
+    } else if (a === '--replace') {
+      if (options.replace) fail('Repeated --replace.')
+      options.replace = true
+    } else fail('Unknown argument: ' + a)
+  }
+  if (options.replace && !options.yes) fail('--replace requires --yes (writes must be explicit).')
+  return options
+}
+function same(a, b) {
+  return a.length === b.length && a.every((v, i) => v === b[i])
+}
+function main() {
+  const o = parse(cliArgs())
+  const path = join(resolve(o.workspace), 'Anchor.toml')
+  if (!existsSync(path)) fail('No Anchor.toml found at ' + path)
+  const ids = parseAnchorDevnetPrograms(readFileSync(path, 'utf8'))
+  const configPath = resolve('oar.config.json')
+  const cfg = JSON.parse(readFileSync(configPath, 'utf8'))
+  if (cfg.cluster !== 'solana:devnet' || cfg.standard !== '0.1')
+    fail('Only OAR App Standard 0.1 Devnet config is supported.')
+  if (!Array.isArray(cfg.programs) || !cfg.programs.every((v) => typeof v === 'string'))
+    fail('oar.config.json programs must be an array of addresses.')
+  const current = cfg.programs
+  console.log('Anchor program addresses on Devnet (declarations, NOT deployed proofs):')
+  for (const id of ids) console.log('  ' + id)
+  if (same(current, ids)) return console.log('OAR config already matches. No change.')
+  if (!o.yes) return console.log('Preview only. Run again with --yes to update oar.config.json.')
+  if (current.length && !o.replace)
+    fail('Refusing to replace existing program list; use --yes --replace after reviewing the preview.')
+  writeFileSync(configPath, JSON.stringify({ ...cfg, programs: ids }, null, 2) + '\n')
+  console.log('Updated local oar.config.json. No transaction was sent.')
+  console.log('Run npm run oar:prepare when ready, then link deployed programs with their upgrade authority.')
+}
+try {
+  main()
+} catch (e) {
+  console.error('oar:anchor: ' + e.message)
+  process.exitCode = 1
+}
diff --git a/community/oar-identity-starter/scripts/lib/anchor-programs.mjs b/community/oar-identity-starter/scripts/lib/anchor-programs.mjs
new file mode 100644
index 0000000..bcd1920
--- /dev/null
+++ b/community/oar-identity-starter/scripts/lib/anchor-programs.mjs
@@ -0,0 +1,37 @@
+// Narrow, read-only parser for Anchor.toml [programs.devnet] declarations.
+// Fail closed on unsupported syntax; never infer authority or proof from a program ID.
+import { address } from '@solana/kit'
+
+export function parseAnchorDevnetPrograms(toml) {
+  if (typeof toml !== 'string') throw new TypeError('Anchor.toml must be text.')
+  let section = ''
+  const seen = new Set()
+  const programs = []
+  for (const [i, raw] of toml
+    .replace(/^\uFEFF/, '')
+    .split(/\r?\n/)
+    .entries()) {
+    const line = raw.trim()
+    if (!line || line.startsWith('#')) continue
+    if (line.startsWith('[')) {
+      if (!/^\[\[?[a-zA-Z0-9_.-]+\]\]?$/.test(line)) throw new Error('Invalid TOML section on line ' + (i + 1))
+      section = line
+      continue
+    }
+    if (section !== '[programs.devnet]') continue
+    const match = line.match(/^([A-Za-z][A-Za-z0-9_-]*)\s*=\s*"([1-9A-HJ-NP-Za-km-z]{32,44})"\s*(?:#.*)?$/)
+    if (!match) throw new Error('Unsupported [programs.devnet] entry on line ' + (i + 1))
+    const [, name, program] = match
+    if (seen.has(name)) throw new Error('Duplicate Anchor program name: ' + name)
+    seen.add(name)
+    try {
+      address(program)
+    } catch {
+      throw new Error('Invalid Solana address for ' + name)
+    }
+    if (programs.includes(program)) throw new Error('Duplicate program address: ' + program)
+    programs.push(program)
+  }
+  if (!programs.length) throw new Error('No [programs.devnet] program addresses found in Anchor.toml.')
+  return programs
+}
diff --git a/community/oar-identity-starter/scripts/lib/manifest-uri.mjs b/community/oar-identity-starter/scripts/lib/manifest-uri.mjs
new file mode 100644
index 0000000..b8eeb17
--- /dev/null
+++ b/community/oar-identity-starter/scripts/lib/manifest-uri.mjs
@@ -0,0 +1,65 @@
+// Manifest URI policy for `oar:prepare`. Mirrors `checkManifestUri` in @open-app-registry/sdk, which SDK
+// releases up to 0.1.1-rc.2 do not export; prepare-oar.mjs prefers the SDK's version when it exists.
+const MAX_URI_LEN = 256
+const COMMIT_SHA = /^(?:[0-9a-f]{40}|[0-9a-f]{64})$/
+
+function forgeRef(u) {
+  const parts = u.pathname
+    .split('/')
+    .filter(Boolean)
+    .map((p) => {
+      try {
+        return decodeURIComponent(p)
+      } catch {
+        return p
+      }
+    })
+  if (u.hostname === 'raw.githubusercontent.com') return parts[2] ?? ''
+  if (u.hostname === 'github.com' || u.hostname === 'www.github.com')
+    return ['raw', 'blob'].includes(parts[2]) ? (parts[3] ?? '') : ''
+  if (u.hostname === 'gitlab.com') {
+    const i = parts.indexOf('-')
+    return i >= 0 && ['raw', 'blob'].includes(parts[i + 1]) ? (parts[i + 2] ?? '') : undefined
+  }
+  if (u.hostname === 'cdn.jsdelivr.net' && parts[0] === 'gh') {
+    const at = (parts[2] ?? '').indexOf('@')
+    return at >= 0 ? parts[2].slice(at + 1) : ''
+  }
+  return undefined
+}
+
+/** @returns {{ ok: true } | { ok: false, detail: string }} */
+export function checkManifestUri(uri) {
+  if (new TextEncoder().encode(uri).length > MAX_URI_LEN)
+    return { ok: false, detail: `manifest URI is longer than ${MAX_URI_LEN} bytes` }
+  if (uri.startsWith('ar://') || uri.startsWith('ipfs://')) {
+    return uri.length > (uri.startsWith('ar://') ? 5 : 7)
+      ? { ok: true }
+      : { ok: false, detail: 'manifest URI has no content identifier' }
+  }
+  if (!uri.startsWith('https://'))
+    return { ok: false, detail: `unsupported manifest URI scheme (use https://, ar:// or ipfs://): ${uri}` }
+  let u
+  try {
+    u = new URL(uri)
+  } catch {
+    return { ok: false, detail: `not a valid URL: ${uri}` }
+  }
+  if (u.username || u.password) return { ok: false, detail: 'manifest URI must not embed credentials' }
+  const file = u.pathname.split('/').filter(Boolean).pop() ?? ''
+  if (file.toLowerCase() === 'oar.json') {
+    return {
+      ok: false,
+      detail:
+        '`oar.json` is reserved for domain and repository proofs; host the manifest as a separate file such as oar-manifest.json',
+    }
+  }
+  const ref = forgeRef(u)
+  if (ref !== undefined && !COMMIT_SHA.test(ref)) {
+    return {
+      ok: false,
+      detail: `${uri} ${ref ? `follows the mutable reference "${ref}"` : 'does not name a commit'}; pin the manifest to a full commit SHA (or use ar:// or ipfs://)`,
+    }
+  }
+  return { ok: true }
+}
diff --git a/community/oar-identity-starter/scripts/prepare-oar.mjs b/community/oar-identity-starter/scripts/prepare-oar.mjs
new file mode 100644
index 0000000..31bfaef
--- /dev/null
+++ b/community/oar-identity-starter/scripts/prepare-oar.mjs
@@ -0,0 +1,99 @@
+#!/usr/bin/env node
+// Offline preparation only. Derives an App ID from a PUBLIC key and produces validated files.
+// No signer material, RPC calls, transactions, deployment, or implicit registration.
+import { existsSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs'
+import { dirname, resolve } from 'node:path'
+import { address } from '@solana/kit'
+import * as sdk from '@open-app-registry/sdk'
+import { checkManifestUri as localCheckManifestUri } from './lib/manifest-uri.mjs'
+
+/** `pnpm run x -- --flag` forwards the `--` separator itself; npm and yarn strip it. */
+const cliArgs = () => (process.argv[2] === '--' ? process.argv.slice(3) : process.argv.slice(2))
+
+const { buildClaimFiles, findAppId, hashManifestHex, validateManifest } = sdk
+const checkManifestUri = sdk.checkManifestUri ?? localCheckManifestUri
+
+function fail(reason) {
+  throw new Error(reason)
+}
+function parse(argv) {
+  let creator,
+    force = false,
+    nonce
+  for (let i = 0; i < argv.length; i++) {
+    const arg = argv[i]
+    if (arg === '--creator' && !creator) creator = argv[++i]
+    else if (arg === '--nonce' && nonce === undefined) nonce = argv[++i]
+    else if (arg === '--force') force = true
+    else fail('Unexpected or repeated option: ' + arg)
+  }
+  if (!creator || !/^[1-9A-HJ-NP-Za-km-z]{32,44}$/.test(creator))
+    fail('Provide --creator with a public Solana wallet address (not a keypair file).')
+  if (nonce !== undefined && !/^(0|[1-9][0-9]*)$/.test(nonce)) fail('--nonce must be a non-negative decimal integer.')
+  return { creator: address(creator), nonce, force }
+}
+function save(path, value, force) {
+  if (existsSync(path) && !force) fail('File exists: ' + path + ' (review changes and pass --force to overwrite).')
+  mkdirSync(dirname(path), { recursive: true })
+  writeFileSync(path, JSON.stringify(value, null, 2) + '\n', { flag: 'w' })
+}
+async function main() {
+  const opts = parse(cliArgs())
+  const cfg = JSON.parse(readFileSync('oar.config.json', 'utf8'))
+  if (cfg.standard !== '0.1' || cfg.cluster !== 'solana:devnet')
+    fail('This starter only supports OAR standard 0.1 on solana:devnet.')
+  const n = opts.nonce ?? String(cfg.nonce ?? 0)
+  if (!/^(0|[1-9][0-9]*)$/.test(n)) fail('Invalid config nonce.')
+  const nonce = BigInt(n)
+  if (nonce > 18446744073709551615n) fail('Nonce exceeds u64.')
+  const appId = await findAppId({ creator: opts.creator, nonce })
+  const domains = cfg.domain ? [cfg.domain] : []
+  const repos = cfg.repositories ?? []
+  const programs = cfg.programs ?? []
+  if (!Array.isArray(repos) || !Array.isArray(programs)) fail('repositories and programs must be arrays.')
+  if (cfg.manifestUri !== undefined && typeof cfg.manifestUri !== 'string') fail('manifestUri must be a string.')
+  if (cfg.manifestUri) {
+    const policy = checkManifestUri(cfg.manifestUri.trim())
+    if (!policy.ok) fail('Manifest URI refused: ' + policy.detail)
+  }
+  const files = buildClaimFiles({
+    appId,
+    cluster: cfg.cluster,
+    name: cfg.name,
+    ...(cfg.summary ? { summary: cfg.summary } : {}),
+    categories: [cfg.category ?? 'other'],
+    domains,
+    repositories: repos,
+    programs: programs.map((p) => address(p)),
+    ...(cfg.manifestUri ? { manifestUri: cfg.manifestUri } : {}),
+  })
+  const verified = validateManifest(files.manifest)
+  if (!verified.valid) fail('Manifest failed SDK validation: ' + verified.errors.join('; '))
+  const policy = checkManifestUri(files.manifestUri)
+  if (!policy.ok) fail('Manifest URI refused: ' + policy.detail)
+  const outputs = [
+    ['public/.well-known/oar-manifest.json', files.manifest],
+    ...(domains.length ? [['public/.well-known/oar.json', files.wellKnown]] : []),
+    ...(repos.length ? [['oar.json', files.repoProof]] : []),
+  ]
+  if (repos.length === 0 && existsSync('oar.json'))
+    fail('Stale oar.json exists but no repository is claimed; remove it after reviewing.')
+  if (!opts.force) {
+    for (const [path] of outputs) if (existsSync(path)) fail('Refusing to overwrite ' + path + '; use --force.')
+  }
+  for (const [path, value] of outputs) save(resolve(path), value, opts.force)
+  console.log('App ID: ' + appId)
+  console.log('Cluster: solana:devnet | creator nonce: ' + nonce)
+  console.log('Manifest URI: ' + files.manifestUri)
+  console.log('Manifest SHA-256 (RFC 8785): ' + hashManifestHex(files.manifest))
+  console.log('Prepared ' + outputs.map(([path]) => path).join(', '))
+  console.log(
+    'Not registered. Deploy these files, verify hosting, then sign registration at https://oarprotocol.xyz/register.',
+  )
+  if (programs.length)
+    console.log('Each listed program also needs its upgrade-authority-signed canonical OAR backlink.')
+}
+main().catch((e) => {
+  console.error('oar:prepare: ' + e.message)
+  process.exitCode = 1
+})
