{
  "name": "@open-app-registry/cli",
  "version": "0.1.1-rc.1",
  "description": "Command-line tool for the Open App Registry (OAR)",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "oar": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "oar": "node --import tsx src/index.ts",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@open-app-registry/sdk": "0.1.1-rc.1",
    "@solana/kit": "^8.4.0",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.18"
  }
}
