{
  "name": "oar-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "oar:prepare": "node scripts/prepare-oar.mjs",
    "oar:anchor": "node scripts/import-anchor-programs.mjs"
  },
  "dependencies": {
    "@open-app-registry/sdk": "0.1.1-rc.3",
    "@solana/kit": "^8.4.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.9.0",
  "displayName": "OAR App Standard — Next.js",
  "description": "Next.js Solana starter with OAR App ID, manifest and bidirectional verification",
  "usecase": "Starter",
  "keywords": [
    "solana",
    "oar",
    "application-identity",
    "nextjs",
    "solana-kit",
    "typescript",
    "devnet"
  ],
  "create-solana-dapp": {
    "instructions": [
      "An OAR-ready starter is not a registered or verified application.",
      "Start building:",
      "+{pm} run dev",
      "Edit oar.config.json with your real domain, repository and any deployed program IDs, then prepare identity files from your PUBLIC creator address:",
      "+{pm} run oar:prepare -- --creator YOUR_PUBLIC_WALLET",
      "Host the generated files, register on Devnet with your own wallet at https://oarprotocol.xyz/register, and inspect every link's state."
    ],
    "skills": []
  }
}
