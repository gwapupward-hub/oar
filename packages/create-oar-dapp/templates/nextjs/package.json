{
  "name": "oar-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "oar:prepare": "node scripts/prepare-oar.mjs",
    "oar:anchor": "node scripts/import-anchor-programs.mjs"
  },
  "dependencies": {
    "@open-app-registry/sdk": "https://github.com/gwapupward-hub/oar/releases/download/v0.1.1-rc.2/open-app-registry-sdk-0.1.1-rc.2.tgz",
    "@solana/kit": "^8.4.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.9.0",
  "displayName": "OAR App Standard — Next.js",
  "description": "Next.js Solana starter with OAR App ID, manifest and bidirectional verification",
  "usecase": "Starter",
  "keywords": [
    "solana",
    "oar",
    "application-identity",
    "nextjs",
    "solana-kit",
    "typescript",
    "devnet"
  ],
  "create-solana-dapp": {
    "instructions": [
      "An OAR-ready starter is not a registered or verified application.",
      "Edit oar.config.json: choose your real domain, repository and any deployed program IDs.",
      "Start building: +{pm} run dev",
      "After choosing your PUBLIC creator address: +{pm} run oar:prepare -- --creator YOUR_PUBLIC_WALLET",
      "Then host the proof files, register on Devnet using your wallet at https://oarprotocol.xyz/register, and verify every link."
    ],
    "rename": {
      "OAR Starter App": {
        "to": "{{name}}",
        "paths": [
          "oar.config.json"
        ]
      }
    },
    "skills": []
  }
}
